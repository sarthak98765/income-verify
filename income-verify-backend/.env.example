NODE_ENV=development
APP_PORT=5920
# Comma-separated origin allowlist. Empty = any origin; set it in production.
CORS_ORIGINS=
# Proxies in front of the API (1 behind nginx), so rate limits see the client's IP.
TRUST_PROXY=0
# Cloudflare Turnstile secret key. Empty = no bot check (local). Test key that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# ── Same Postgres and RabbitMQ as the ML worker (docker compose, non-default ports) ──
DATABASE_URL=postgresql://income:income@localhost:5434/income_verify
RABBITMQ_URL=amqp://income:income@localhost:5674/

# ── Files: shared with the worker; paths are relative to this folder ──
STORAGE_DIR=../storage
SAMPLES_DIR=../income-verify-ml/data/dev

# Applications older than this are deleted with their files; 0 keeps everything.
RETENTION_HOURS=24
